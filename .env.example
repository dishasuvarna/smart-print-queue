# Copy to .env for local development or production — only the VALUES
# differ between environments, never the variable names or the code
# that reads them (point 3).

DEBUG=True
SECRET_KEY=change-me-to-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1

# Local: matches docker-compose.yml.
# Production: Supabase connection string — Project Settings > Database > Connection string.
DATABASE_URL=postgres://smart_print:localdevpassword@localhost:5432/smart_print

# Local: matches docker-compose.yml.
# Production: Upstash Redis connection string — use the "rediss://" TLS URL.
REDIS_URL=redis://localhost:6379/0

# Razorpay — same variable names for test and live mode, only the values change.
# Test mode keys start with rzp_test_, live mode with rzp_live_.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# Brevo transactional email
BREVO_API_KEY=xxxxxxxxxxxxxxxxxxxx
DEFAULT_FROM_EMAIL=orders@yourcollegeproject.com
SHOPKEEPER_EMAIL=shop@example.com

LOG_LEVEL=INFO

#cd smart_print
#venv\Scripts\activate